#!/bin/bash
# 卸载清理。数据目录（含数据库、会话、插件）属主是 root，应用用户删不掉，
# 因此这里只记录日志；需要连数据一起清掉时请手动执行 rm -rf <数据目录>。
DIR="$(cd "$(dirname "$0")" && pwd)"
[ -f "${DIR}/_common.sh" ] && . "${DIR}/_common.sh"
log "uninstall_callback: 应用已卸载，数据目录保留在 $(wiz wizard_data_dir "${FNOS_DATA_DIR:-/vol1/1000/docker}/motrix" 2>/dev/null)"
exit 0
