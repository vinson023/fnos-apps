#!/bin/bash

CONTAINER_NAME="music-dl"

is_running() {
    docker inspect "$CONTAINER_NAME" 2>/dev/null | grep -q '"Status": "running"'
}

case "$1" in
start)
    exit 0
    ;;
stop)
    exit 0
    ;;
status)
    if is_running; then
        exit 0
    else
        exit 3
    fi
    ;;
*)
    exit 1
    ;;
esac
