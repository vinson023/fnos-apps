server {
    listen 6880;
    listen [::]:6880;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;
    charset utf-8;

    # 静态资源不缓存，配置补丁能立即生效
    location ~* \.(js|css|html)$ {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        expires -1;
    }

    # 把 aria2 的 RPC 密钥下发给前端。
    # 密钥由安装向导决定，只以环境变量形式存在于容器里，不写进任何随包分发的
    # 静态文件——所以发布包可以公开，装完之后页面会自动带上本机的密钥。
    # 前端只在自己没有存过密钥时才用它补默认值，用户在界面里改过的值不会被覆盖。
    location = /aria2/config.js {
        default_type application/javascript;
        add_header Cache-Control "no-store";
        return 200 'window.ARIA2_SECRET="${ARIA2_SECRET}";';
    }

    # 同源反代到 aria2 的 JSON-RPC。
    # ARIA2_RPC 由安装向导决定，容器启动时 nginx 镜像会用 envsubst 把这一处
    # 占位符替换成实际值（只替换 ARIA2_RPC，$remote_addr / $uri 等 nginx
    # 内置变量靠 NGINX_ENVSUBST_FILTER 白名单保护，不会被误替换）。
    location = /aria2/jsonrpc {
        proxy_pass http://${ARIA2_RPC}/jsonrpc;
        proxy_http_version 1.1;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
    }

    location = /healthz {
        access_log off;
        return 200 "ok\n";
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
