server {
    listen 6880;
    listen [::]:6880;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;
    charset utf-8;

    # 静态资源不缓存，配置补丁能立即生效
    location ~* \.(js|css|html)$ {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        expires -1;
    }

    # 同源反代到 aria2 的 JSON-RPC。
    # ARIA2_RPC 由安装向导决定，容器启动时 nginx 镜像会用 envsubst 把这一处
    # 占位符替换成实际值（只替换 ARIA2_RPC，$remote_addr / $uri 等 nginx
    # 内置变量靠 NGINX_ENVSUBST_FILTER 白名单保护，不会被误替换）。
    location = /aria2/jsonrpc {
        proxy_pass http://${ARIA2_RPC}/jsonrpc;
        proxy_http_version 1.1;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
    }

    location = /healthz {
        access_log off;
        return 200 "ok\n";
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
