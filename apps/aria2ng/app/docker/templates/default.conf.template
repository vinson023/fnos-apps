# nginx 配置模板：容器启动时由官方 entrypoint 里的 envsubst 生成
# /etc/nginx/conf.d/default.conf。
#
# 只有 ${WEB_PORT} 会被替换（compose 里设了 NGINX_ENVSUBST_FILTER=WEB_PORT），
# 下面那些 $uri / $host 之类的 nginx 变量原样保留 —— 不设 filter 的话
# envsubst 会把它们全部替换成空字符串，站点直接废掉。
#
# 端口用同一个变量同时决定「容器内监听端口」和「宿主机映射端口」：
#   host 模式：nginx 直接监听 ${WEB_PORT}，ports 被 Docker 忽略（只警告）
#   bridge 模式：nginx 监听 ${WEB_PORT}，ports 把 ${WEB_PORT} 映射到同一个号
# 两种模式下对外都是同一个端口号，用户不用关心自己选的是哪种网络。
server {
    listen ${WEB_PORT};
    listen [::]:${WEB_PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;
    charset utf-8;

    # 静态资源与语言文件都不缓存：升级 fpk 后刷新即生效，
    # 不会被浏览器或 webview 里的旧文件卡住
    location ~* \.(js|css|html|txt)$ {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        expires -1;
    }

    # 语言文件必须严格按文件名取，缺失就老实返回 404。
    # 不能落到下面的 try_files 兜底上——那样会把 index.html 当语言文件返回，
    # AriaNg 解析失败后整站退回英文。
    location /langs/ {
        try_files $uri =404;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        expires -1;
    }

    # 服务端配置（RPC 地址/端口/密钥）绝不能缓存：改完刷新就要生效。
    # 缺失时必须老实 404——被下面的 try_files 兜底成 index.html 的话，
    # 浏览器会拿一段 HTML 当 JS 执行，配置静默失效。
    location = /rpc-config.js {
        try_files $uri =404;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        expires -1;
    }

    location = /healthz {
        access_log off;
        return 200 "ok\n";
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
